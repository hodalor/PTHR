PORT=8000
MONGO_URI=mongodb+srv://username:password@cluster-url/db-name
MONGO_DB_NAME=hr
JWT_SECRET=change-this-in-production
GCS_BUCKET_NAME=your-bucket-name
GCS_PROJECT_ID=your-project-id
GCS_CLIENT_EMAIL=your-service-account-email
GCS_PRIVATE_KEY_ID=your-private-key-id
GCS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
PAYSTACK_PUBLIC_KEY=pk_test_your_public_key
PAYSTACK_SECRET_KEY=sk_test_your_secret_key
PAYSTACK_CALLBACK_BASE_URL=https://your-frontend-app-url.example.com/

# Password reset OTP (pay-as-you-go)
APP_NAME=PTHR
PASSWORD_RESET_OTP_TTL_SECONDS=600
PASSWORD_RESET_MAX_ATTEMPTS=5
PASSWORD_RESET_MIN_PASSWORD_LENGTH=8
OTP_DEFAULT_COUNTRY_CODE=233
# Set true in non-production to print OTP codes when providers are not configured
OTP_DEBUG_LOG=true
# Email via Resend (https://resend.com) — pay as you go
RESEND_API_KEY=
RESEND_FROM_EMAIL=PTHR <noreply@your-domain.com>
# SMS via Twilio — pay as you go (works alongside Firebase Blaze if you prefer that console)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+15551234567

# Payroll auto-generate scheduler (checks every 15 minutes by default)
PAYROLL_AUTO_GENERATE_INTERVAL_MS=900000
