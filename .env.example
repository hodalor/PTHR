# Build/runtime mode for local development. React only exposes `REACT_APP_*`
# variables to the browser bundle; this value is mainly for local tooling.
NODE_ENV=development

# Optional base path when serving the built app from a subdirectory.
# Leave empty for root hosting.
PUBLIC_URL=

# Backend API base URL. In local development the app falls back to
# http://localhost:8000 when this is omitted.
REACT_APP_API_BASE_URL=https://pthr.onrender.com

# Optional Google Maps tile key for map-enabled views.
REACT_APP_GOOGLE_MAPS_TILE_KEY=your-google-maps-tile-key
